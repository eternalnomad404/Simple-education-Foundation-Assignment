# Copy this file to .env and adjust the values.
#
#   cp .env.example .env
#
# The defaults below are enough to run the application locally with
# `docker compose up --build`. Change the passwords and secrets before using
# them anywhere that is not your own machine.

# --- PostgreSQL --------------------------------------------------------------
# With Docker Compose the database is created with these credentials on first
# start. POSTGRES_SERVER and POSTGRES_PORT are only used when running the
# application outside Docker; Compose overrides them.
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=communicator
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432

# --- Redis (token blacklist used by logout) ----------------------------------
# Only used when running outside Docker; Compose overrides them.
# Note: the variable really is spelled REDIST_PORT in app/config.py.
REDIS_HOST=localhost
REDIST_PORT=6379

# --- Authentication ----------------------------------------------------------
# Secret used to sign login tokens. Use a long random value, for example the
# output of: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters
JWT_ALGORITHM=HS256

# --- Webhooks ----------------------------------------------------------------
# Value expected in the X-Webhook-Secret header on /webhook/* requests.
WEBHOOK_SECRET=communicator_key

# --- Application -------------------------------------------------------------
APP_NAME=Communicator
APP_DOMAIN=localhost:8000

# Port the API is published on by Docker Compose.
APP_PORT=8000
